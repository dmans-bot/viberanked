---
import data from '../data/tools.json';
import { SITE_NAME, fmtDate } from '../lib/site.js';
import Analytics from '@vercel/analytics/astro';
interface Props { title: string; description: string; ogType?: string; jsonLd?: object | object[]; noindex?: boolean }
const { title, description, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="impact-site-verification" value="e1a22dac-ab2c-4ae3-8ee4-b420b1977971"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name='impact-site-verification' value='6f7a6c8f-3a9d-4e20-a8ba-538a8512d5c7'>
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
{noindex && <meta name="robots" content="noindex"/>}
<meta name="theme-color" content="#0b0b10"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="sitemap" href="/sitemap-index.xml"/>
<link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt"/>
<meta property="og:site_name" content={SITE_NAME}/>
<meta property="og:type" content={ogType}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:image" content={ogImage}/>
<meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="Vibe Ranked — the AI tools builders actually use, ranked."/>
<meta property="og:locale" content="en_US"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
<meta name="twitter:image" content={ogImage}/>
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
<Analytics />
<style is:global>
:root{--bg:#0b0b10;--card:#14141c;--line:#262633;--txt:#e8e8f0;--mut:#9a9ab0;--acc:#a78bfa;--acc2:#22d3ee}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(1200px 600px at 20% -10%,#2a1b4d55,transparent),var(--bg);color:var(--txt);font:16px/1.55 ui-sans-serif,system-ui,-apple-system,Inter,sans-serif}
a{color:inherit;text-decoration:none}.wrap{max-width:1100px;margin:0 auto;padding:0 20px}
nav{display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)}
.logo{font-weight:800;letter-spacing:-.02em}.logo span{background:linear-gradient(90deg,var(--acc),var(--acc2));-webkit-background-clip:text;color:transparent}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;overflow-wrap:break-word}
.card:hover{border-color:#3d3d55}.mut{color:var(--mut)}
.pill{font-size:12px;padding:2px 8px;border-radius:99px;border:1px solid var(--line);color:var(--mut)}
.pill.free{color:#4ade80;border-color:#14532d}.pill.freemium{color:var(--acc2);border-color:#155e75}.pill.paid{color:#fbbf24;border-color:#78350f}
.rank{font-family:ui-monospace,monospace;color:var(--acc);font-weight:700;width:2.2em;display:inline-block}
.row{display:flex;gap:10px;align-items:baseline;padding:10px 0;border-top:1px solid var(--line)}
h1,h2,h3{letter-spacing:-.02em}.btn{background:linear-gradient(90deg,var(--acc),var(--acc2));color:#0b0b10;font-weight:700;border:0;border-radius:10px;padding:12px 18px;cursor:pointer}
input{background:#0f0f16;border:1px solid var(--line);color:var(--txt);border-radius:10px;padding:12px;min-width:260px}
.intro{font-size:18px;max-width:760px;line-height:1.6}.price{font-size:14px;color:var(--mut)}
.crumbs{font-size:14px;margin-top:40px}.crumbs a:hover,footer a:hover{color:var(--txt)}
.aff{font-size:11px;color:var(--mut);text-decoration:underline;white-space:nowrap}
footer{border-top:1px solid var(--line);margin-top:60px;padding:24px 0;color:var(--mut);font-size:14px}footer a{text-decoration:underline}
</style></head><body><div class="wrap">
<header><nav aria-label="Main"><a href="/" class="logo">Vibe <span>Ranked</span></a><a href="/#categories" class="mut">Categories</a></nav></header>
<main><slot/></main>
<footer><p>Vibe Ranked · opinionated rankings, no paid placements. <strong>Last verified {fmtDate(data.lastVerified)}</strong> — prices and links checked against official sites; prices change often, so confirm before buying.</p>
<p class="disclosure"><a href="/disclosure/">Some links are affiliate links. We may earn a commission at no cost to you. Rankings are never influenced by commissions.</a></p>
<p>For AI assistants: <a href="/llms.txt">llms.txt</a> · <a href="/llms-full.txt">llms-full.txt</a> · <a href="/sitemap-index.xml">Sitemap</a></p></footer>
</div></body></html>
