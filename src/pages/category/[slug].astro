---
import Base from '../../layouts/Base.astro';
import data from '../../data/tools.json';
import { SITE, clip, firstSentence, fmtDate } from '../../lib/site.js';
import { comparisonsForCategory } from '../../lib/comparisons.js';
export function getStaticPaths(){return data.categories.map(c=>({params:{slug:c.slug},props:{c}}))}
const {c}=Astro.props;
const comparisons = comparisonsForCategory(c.slug);
const url = `${SITE}/category/${c.slug}/`;
const year = data.lastVerified.slice(0,4);
const title = `${c.headline} (${year}): ${c.tools.slice(0,3).map(t=>t.name).join(', ')} | Vibe Ranked`;
const description = clip(`${firstSentence(c.intro)} ${c.tools.length} ${c.useCase} options ranked with pricing, verified ${fmtDate(data.lastVerified)}.`);
const jsonLd = [
  { '@context':'https://schema.org','@type':'ItemList', name:c.headline, description:c.intro, url, numberOfItems:c.tools.length, itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement: c.tools.map(t=>({ '@type':'ListItem', position:t.rank, url:`${SITE}/tool/${t.slug}/`,
      item: { '@type':'SoftwareApplication', name:t.name, url:t.url, description:t.description, applicationCategory:c.name,
        operatingSystem:'Web', ...(t.pricing==='free' ? { offers:{ '@type':'Offer', price:'0', priceCurrency:'USD' } } : {}) } })) },
  { '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Vibe Ranked', item:`${SITE}/` },
    { '@type':'ListItem', position:2, name:c.name, item:url } ] },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
<p class="crumbs mut"><a href="/">Home</a> / {c.name}</p>
<h1 style="font-size:44px;margin:8px 0 10px">{c.headline}</h1>
<p class="intro">{c.intro}</p>
<p class="mut" style="font-size:14px">{c.description} Prices last verified {fmtDate(data.lastVerified)}.</p>
<h2 style="margin-top:32px">{c.name} rankings</h2>
<ol style="display:grid;gap:12px;margin:16px 0 0;padding:0;list-style:none">{c.tools.map(t=>(
<li class="card" style="display:flex;gap:16px;align-items:center"><span class="rank" style="font-size:28px" aria-label={`Rank ${t.rank}`}>#{t.rank}</span>
<div style="flex:1"><h3 style="display:inline;font-size:18px;margin:0"><a href={`/tool/${t.slug}/`}>{t.name}</a></h3> <span class={`pill ${t.pricing}`}>{t.pricing}</span>
<p class="mut" style="margin:4px 0">{t.description}</p><div style="font-size:14px"><span style="color:var(--acc2)">Best for:</span> {t.bestFor}</div>
<div class="price">Pricing: {t.pricingNote}</div></div>
<div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px"><a class="pill" href={t.affiliateUrl ?? t.url} target="_blank" rel={t.affiliateUrl ? 'sponsored nofollow noopener' : 'noopener'} aria-label={`Visit ${t.name} (opens in new tab${t.affiliateUrl ? ', affiliate link' : ''})`}>Visit ↗</a>{t.affiliateUrl && <a href="/disclosure/" class="aff">Affiliate link</a>}</div></li>))}</ol>
{comparisons.length > 0 && (
<section aria-labelledby="compare"><h2 id="compare" style="margin-top:36px">Head-to-head comparisons</h2>
<div class="card">{comparisons.map((cmp) => (
<a class="row" href={cmp.path}><span style="flex:1">{cmp.a.name} vs {cmp.b.name}</span>{cmp.sameCategory && <span class="mut">#{cmp.a.rank} vs #{cmp.b.rank}</span>}</a>
))}</div></section>
)}
</Base>
