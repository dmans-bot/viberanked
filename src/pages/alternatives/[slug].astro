---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import data from '../../data/tools.json';
import { SITE, fmtDate } from '../../lib/site.js';
import { getAlternatives } from '../../lib/alternatives.js';
import { comparisonsForTool } from '../../lib/comparisons.js';
import { guidesForCategory } from '../../lib/guides.js';

export function getStaticPaths() {
  return getAlternatives().map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const comparisons = comparisonsForTool(page.tool.slug);
const guides = guidesForCategory(page.category.slug);
const crumbLd = [
  { '@type': 'ListItem', position: 1, name: 'Vibe Ranked', item: `${SITE}/` },
  { '@type': 'ListItem', position: 2, name: page.category.name, item: `${SITE}/category/${page.category.slug}/` },
  { '@type': 'ListItem', position: 3, name: page.headline, item: page.url },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbLd },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: page.headline,
    description: page.intro,
    url: page.url,
    numberOfItems: page.alternatives.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: page.alternatives.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE}/tool/${t.slug}/`,
      item: {
        '@type': 'SoftwareApplication',
        name: t.name,
        url: t.url,
        description: t.description,
        applicationCategory: page.category.name,
        operatingSystem: 'Web',
        ...(t.pricing === 'free' ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } } : {}),
      },
    })),
  },
];
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
<p class="crumbs mut"><a href="/">Home</a> / <a href={`/category/${page.category.slug}/`}>{page.category.name}</a> / {page.headline}</p>
<h1 style="font-size:clamp(32px,5vw,48px);margin:8px 0 10px">{page.headline}</h1>
<p class="intro">{page.intro}</p>
<p class="mut" style="font-size:14px">Prices last verified {fmtDate(data.lastVerified)}. <a href={`/tool/${page.tool.slug}/`}>{page.tool.name} details</a> · <a href={`/category/${page.category.slug}/`}>Full {page.category.name} leaderboard</a>.</p>
<h2 style="margin-top:32px">Ranked alternatives</h2>
<ol style="display:grid;gap:12px;margin:16px 0 0;padding:0;list-style:none">{page.alternatives.map((t) => (
<li class="card" style="display:flex;gap:16px;align-items:center"><span class="rank" style="font-size:28px" aria-label={`Rank ${t.rank}`}>#{t.rank}</span>
<div style="flex:1"><h3 style="display:inline;font-size:18px;margin:0"><a href={`/tool/${t.slug}/`}>{t.name}</a></h3> <span class={`pill ${t.pricing}`}>{t.pricing}</span>
<p class="mut" style="margin:4px 0">{t.description}</p>
<div style="font-size:14px"><span style="color:var(--acc2)">Pick this if:</span> {t.bestFor}</div>
<div class="price">Pricing: {t.pricingNote}</div>
{t.comparison && <div style="font-size:14px;margin-top:4px"><a href={t.comparison.path} style="color:var(--acc)">{t.comparison.a.name} vs {t.comparison.b.name}</a></div>}
</div>
<div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px"><a class="pill" href={t.affiliateUrl ?? t.url} target="_blank" rel={t.affiliateUrl ? 'sponsored nofollow noopener' : 'noopener'} aria-label={`Visit ${t.name} (opens in new tab${t.affiliateUrl ? ', affiliate link' : ''})`}>Visit ↗</a>{t.affiliateUrl && <a href="/disclosure/" class="aff">Affiliate link</a>}</div></li>
))}</ol>
<Newsletter />
<section aria-labelledby="faq">
<h2 id="faq" style="margin-top:36px">Questions</h2>
{page.faqs.map((f) => (
<div class="card" style="margin-top:12px"><h3 style="margin:0 0 8px;font-size:18px">{f.q}</h3><p style="margin:0">{f.a}</p></div>
))}
</section>
<section aria-labelledby="more">
<h2 id="more" style="margin-top:36px">More from this ranking</h2>
<div class="card">
<a class="row" href={`/category/${page.category.slug}/`}><span style="flex:1;color:var(--acc)">All {page.category.name} rankings →</span></a>
<a class="row" href={`/tool/${page.tool.slug}/`}><span style="flex:1">{page.tool.name} details</span></a>
{comparisons.map((cmp) => (
<a class="row" href={cmp.path}><span style="flex:1">{cmp.a.name} vs {cmp.b.name}</span>{cmp.sameCategory && <span class="mut">#{cmp.a.rank} vs #{cmp.b.rank}</span>}</a>
))}
{guides.map((g) => (
<a class="row" href={g.path}><span style="flex:1">{g.headline}</span></a>
))}
</div>
</section>
</Base>
